  },
  "dependencies": {
    "@hpke/core": "^1.7.5",
    "@hpke/dhkem-x25519": "^1.6.5",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
