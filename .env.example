# Primatio Vault API base URL
PRIMATIO_BASE_URL=https://api.primat.io

# Agent client ID created in the Primatio Vault app ("My Agents" -> DPoP mode)
PRIMATIO_CLIENT_ID=cli_your_agent_id

# Target website login URL to test
PRIMATIO_TARGET_URL=https://practicetestautomation.com/practice-test-login/

# REMEMBER TO SAVE THE CREDENTIALS ON YOUR VAULT APP BEFORE THE LOGIN!

# Optional purpose shown on the mobile biometric approval screen
PRIMATIO_PURPOSE=Automated login verification demo

# Set to false to watch the Chromium browser window during login
HEADLESS=true
